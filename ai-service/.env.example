# API Key de Google Gemini (Obtenela en https://aistudio.google.com/)
GEMINI_API_KEY=REEMPLAZAR_CON_TU_API_KEY_DE_GEMINI

# Token interno para autenticar peticiones provenientes del backend .NET
# Debe coincidir EXACTAMENTE con AiService:TokenInterno en appsettings.Development.json
TOKEN_INTERNO_BACKEND=REEMPLAZAR_CON_UN_TOKEN_SEGURO_GENERADO_LOCALMENTE

# (Opcional) Modelo de Gemini a utilizar
GEMINI_MODEL=gemini-3.5-flash-lite
